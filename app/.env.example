# Copy to .env.local for `npm run dev`. On Vercel, set these in
# Project Settings → Environment Variables instead.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Signs login sessions. At least 32 random characters, e.g. `openssl rand -base64 48`.
AUTH_SECRET=

# First administrator, created only while the users table is empty.
ADMIN_EMAIL=admin@ciptaharmoni.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
